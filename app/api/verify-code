import { NextRequest, NextResponse } from 'next/server';
import { createClient } from '@supabase/supabase-js';

export async function POST(req: NextRequest) {
  try {
    const { email, code } = await req.json();
    if (!email || !code) return NextResponse.json({ valid: false }, { status: 400 });

    const supabaseAdmin = createClient(
      process.env.NEXT_PUBLIC_SUPABASE_URL!,
      process.env.SUPABASE_SERVICE_ROLE_KEY!
    );

    const { data, error } = await supabaseAdmin
      .from('email_codes')
      .select('*')
      .eq('email', email.toLowerCase().trim())
      .single();

    if (error || !data) return NextResponse.json({ valid: false, error: 'Няма такъв код' });

    if (data.code !== code.trim()) {
      return NextResponse.json({ valid: false, error: 'Грешен код' });
    }

    if (new Date(data.expires_at) < new Date()) {
      return NextResponse.json({ valid: false, error: 'Кодът е изтекъл' });
    }

    // Изтриваме кода след успешно използване
    await supabaseAdmin.from('email_codes').delete().eq('email', email.toLowerCase().trim());

    return NextResponse.json({ valid: true });

  } catch (e: any) {
    return NextResponse.json({ valid: false, error: e.message }, { status: 500 });
  }
}